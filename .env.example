# Public application URL used to build referral links.
NEXT_PUBLIC_APP_URL=http://localhost:3000

# Supabase project connection and Auth.
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_replace_me
# Prefer the modern sb_secret_ key. The legacy service-role JWT remains supported.
SUPABASE_SECRET_KEY=sb_secret_replace_me
SUPABASE_SERVICE_ROLE_KEY=

# Use at least 32 random bytes for each secret.
REFERRAL_SIGNING_SECRET=replace_with_32_or_more_random_characters
COOKIE_SIGNING_SECRET=replace_with_a_different_32_or_more_character_secret
DEVICE_HASH_SECRET=replace_with_a_third_32_or_more_character_secret

# Browser key: restrict by HTTP referrer and to Maps JavaScript + Places.
NEXT_PUBLIC_GOOGLE_MAPS_BROWSER_KEY=
NEXT_PUBLIC_GOOGLE_MAP_ID=

# Server key: restrict to Places API (New) and Routes API.
GOOGLE_MAPS_SERVER_KEY=
